let arr = [10, 5, 8, 10, 3, 8];

let largest = -Infinity;
let secondLargest = -Infinity;

for (let x of arr) {
    if (x > largest) {
        secondLargest = largest;
        largest = x;
    }
    else if (x > secondLargest && x !== largest) {
        secondLargest = x;
    }
}

console.log(secondLargest);